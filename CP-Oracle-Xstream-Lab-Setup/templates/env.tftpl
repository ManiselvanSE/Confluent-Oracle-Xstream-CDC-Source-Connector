# Generated by Terraform - change terraform.tfvars and re-apply instead of editing on the host.
# Read by 'docker compose' and sourced by every bin/*.sh script.
COMPOSE_PROJECT_NAME='cdc-xstream'

# Versions
CP_VERSION='${cp_version}'
ORACLE_IMAGE='${oracle_image}'
XSTREAM_CONNECTOR_VERSION='${xstream_connector_version}'
JDBC_CONNECTOR_VERSION='${jdbc_connector_version}'
C3_VERSION='${c3_version}'
INSTANT_CLIENT_URL='${instant_client_url}'
DOCKER_COMPOSE_VERSION='${docker_compose_version}'
DOCKER_BUILDX_VERSION='${docker_buildx_version}'
SAMPLE_DATA_BASE_URL='${sample_data_base_url}'

# Host
BIND_ADDRESS='${bind_address}'
MIN_FREE_DISK_GB='${min_free_disk_gb}'
SWAP_SIZE_GB='${swap_size_gb}'

# Kafka / Schema Registry / Connect
KAFKA_ADVERTISED_HOST='${kafka_advertised_host}'
KAFKA_CLUSTER_ID='${kafka_cluster_id}'
KAFKA_HEAP='${kafka_heap}'
SCHEMA_REGISTRY_HEAP='${schema_registry_heap}'
CONNECT_HEAP='${connect_heap}'
CONNECTOR_NAME='${connector_name}'
TOPIC_PREFIX='${topic_prefix}'
TOPIC_RETENTION_MS='${topic_retention_ms}'

# Control Center (compose profile "c3")
COMPOSE_PROFILES='${c3_enabled ? "c3" : ""}'
C3_ENABLED='${c3_enabled}'
C3_HEAP='${c3_heap}'

# JDBC sink (Kafka -> Oracle sink_schema)
JDBC_SINK_ENABLED='${jdbc_sink_enabled}'
JDBC_SINK_NAME='${jdbc_sink_name}'
SINK_SCHEMA='${sink_schema}'
SINK_SCHEMA_PWD='${sink_schema_pwd}'

# Oracle / XStream
ORACLE_PWD='${oracle_pwd}'
ORACLE_PDB='${oracle_pdb}'
CDC_ADMIN_USER='${admin_user}'
CDC_ADMIN_PWD='${admin_pwd}'
CDC_USER='${cdc_user}'
CDC_USER_PWD='${cdc_pwd}'
OUTBOUND_SERVER='${outbound_server}'
CAPTURE_NAME='${capture_name}'
CAPTURE_SCHEMA='${capture_schema}'
REDO_LOG_SIZE_MB='${redo_log_size_mb}'
RECOVERY_AREA_SIZE_GB='${recovery_area_size_gb}'
